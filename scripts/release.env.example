# Copy this file to scripts/release.env and fill in your local signing values.
# scripts/release.env is intentionally ignored by git.

# Required for Developer ID signing.
# Example:
# DEVELOPER_ID_APPLICATION="Developer ID Application: Your Name (TEAMID)"
DEVELOPER_ID_APPLICATION=""

# Recommended: store notarization credentials in your login keychain:
# xcrun notarytool store-credentials "coollama-notary" \
#   --apple-id "you@example.com" \
#   --team-id "TEAMID" \
#   --password "app-specific-password"
#
# Then use:
# NOTARY_PROFILE="coollama-notary"
NOTARY_PROFILE=""

# Alternative to NOTARY_PROFILE. Keep these only in scripts/release.env.
# APPLE_ID="you@example.com"
# APPLE_TEAM_ID="TEAMID"
# APP_SPECIFIC_PASSWORD="xxxx-xxxx-xxxx-xxxx"
